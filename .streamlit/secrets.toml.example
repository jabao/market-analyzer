# Example Streamlit secrets for Market Analyzer LLM Assistant
# Copy this to .streamlit/secrets.toml and fill in your keys
# You can also set via environment variables ANTHROPIC_API_KEY and OPENAI_API_KEY

# Direct top-level (checked by provider)
ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."

# Or nested under [llm] section (also supported)
[llm]
anthropic_api_key = "sk-ant-..."
openai_api_key = "sk-..."
