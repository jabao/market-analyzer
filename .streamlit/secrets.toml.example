# Example Streamlit secrets for Market Analyzer LLM Assistant
# Copy this to .streamlit/secrets.toml and fill in your keys
# You can also set via environment variables ANTHROPIC_API_KEY and OPENAI_API_KEY

# Direct top-level (checked by provider)
ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."

# Plaid brokerage imports
# Environment can be sandbox, development, or production.
PLAID_CLIENT_ID = "your-plaid-client-id"
PLAID_SECRET = "your-plaid-secret"
PLAID_ENV = "sandbox"
# Optional. Use only when your network requires a custom CA bundle.
PLAID_CA_BUNDLE = ""
# Optional timeout tuning for slow networks.
PLAID_CONNECT_TIMEOUT_SECONDS = "10"
PLAID_READ_TIMEOUT_SECONDS = "30"

# Or nested under [llm] section (also supported)
[llm]
anthropic_api_key = "sk-ant-..."
openai_api_key = "sk-..."

[plaid]
client_id = "your-plaid-client-id"
secret = "your-plaid-secret"
env = "sandbox"
# Optional. Use only when your network requires a custom CA bundle.
ca_bundle = ""
# Optional timeout tuning for slow networks.
connect_timeout_seconds = "10"
read_timeout_seconds = "30"
# Optional. If omitted, Plaid Link will allow institution selection.
robinhood_institution_id = ""
